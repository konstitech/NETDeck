# Replace the example origin https://ci.example.com with your real HTTPS origin.
WOODPECKER_HOST=
# GitHub login of the administrator allowed to sign in.
WOODPECKER_ADMIN=
# Public client ID of the GitHub OAuth App; secrets belong in secret files.
WOODPECKER_GITHUB_CLIENT=
# Numeric group of agent-secret; use the operator's primary GID if it is not 1000.
WOODPECKER_AGENT_SECRET_GID=1000
